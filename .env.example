NEBIUS_API_KEY=put-your-nebius-token-factory-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FALLBACK_MODELS=
GEMINI_API_KEY=put-your-google-ai-studio-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_IMPORT_MODEL=gemini-3.1-flash-lite
GEMINI_IMPORT_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash
OPENROUTER_API_KEY=put-your-openrouter-key-here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_IMPORT_MODEL=openrouter/free
OPENROUTER_IMPORT_FALLBACK_MODELS=
PORT=4175
# Optional: path to a TexasSolver console binary and its resources folder
TEXAS_SOLVER_BINARY=
TEXAS_SOLVER_RESOURCES=
TEXAS_SOLVER_TIMEOUT_MS=90000
IMPORT_ENGINE_V2_ENABLED=false
IMPORT_ENGINE_V2_SITES=Natural8
IMPORT_ENGINE_V2_DEBUG=false
IMPORT_PROVIDER_ORDER=gemini,openrouter
SCREENSHOT_IMPORT_TIMEOUT_MS=30000
